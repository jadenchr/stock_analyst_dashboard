{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "app/api/stock/[ticker]/financials/route.ts": {
      "maxDuration": 15
    },
    "app/api/stock/[ticker]/historical/route.ts": {
      "maxDuration": 15
    },
    "app/api/stock/[ticker]/technicals/route.ts": {
      "maxDuration": 20
    },
    "app/api/analyze/route.ts": {
      "maxDuration": 30
    },
    "app/api/market/overview/route.ts": {
      "maxDuration": 15
    },
    "app/api/market/regional/route.ts": {
      "maxDuration": 20
    },
    "app/api/market/movers/route.ts": {
      "maxDuration": 15
    },
    "app/api/market/sectors/route.ts": {
      "maxDuration": 20
    }
  }
}
