# =====================================================================
# StockVision — Local environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# =====================================================================

# --- Market data providers ---
# Yahoo Finance requires no key (yahoo-finance2 npm package).
YAHOO_FINANCE_ENABLED=true

# Alpha Vantage: free tier ~5 req/min — used for RSI, MACD, SMA, EMA.
# Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub: free tier — used for news, insider tx, analyst consensus.
# Get a key at https://finnhub.io/register
FINNHUB_API_KEY=

# NewsAPI: fallback news source when Finnhub returns empty.
# Get a key at https://newsapi.org/register
NEWS_API_KEY=

# CSE (Colombo Stock Exchange) requires no key — uses public cse.lk endpoints.

# --- Supabase (Phase 7a — Auth + per-user data) ---
# Get them at https://supabase.com → Project → Settings → API
# The publishable key (new format `sb_publishable_...`) OR the legacy JWT anon key both work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI (Phase 4 — OpenRouter, required for live AIRating) ---
# Get a key at https://openrouter.ai → Keys → Create Key
# Add at least $5 credits — typical analysis costs ~$0.004
OPENROUTER_API_KEY=
# Override default model if desired. Tested with gemini-2.5-pro.
# Alternatives: anthropic/claude-sonnet-4.5, openai/gpt-4o, google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-pro

# Optional alternative — Claude direct (currently unused in favor of OpenRouter)
ANTHROPIC_API_KEY=

# --- Caching / rate limiting ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: Vercel KV for persistent rate-limit + cache state across cold starts.
# Without these, falls back to in-process LRU.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_DISCLAIMER="Market data may be delayed up to 15 minutes."
