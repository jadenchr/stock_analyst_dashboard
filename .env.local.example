# =====================================================================
# StockVision — Local environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# =====================================================================

# --- Market data providers ---
# Yahoo Finance requires no key (yahoo-finance2 npm package).
YAHOO_FINANCE_ENABLED=true

# Alpha Vantage: free tier ~5 req/min — used for RSI, MACD, SMA, EMA.
# Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub: free tier — used for news, insider tx, analyst consensus.
# Get a key at https://finnhub.io/register
FINNHUB_API_KEY=

# NewsAPI: fallback news source when Finnhub returns empty.
# Get a key at https://newsapi.org/register
NEWS_API_KEY=

# CSE (Colombo Stock Exchange) requires no key — uses public cse.lk endpoints.

# --- AI (Phase 4 — required for live AIRating; stubbed without it) ---
ANTHROPIC_API_KEY=

# --- Caching / rate limiting ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: Vercel KV for persistent rate-limit + cache state across cold starts.
# Without these, falls back to in-process LRU.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_DISCLAIMER="Market data may be delayed up to 15 minutes."
